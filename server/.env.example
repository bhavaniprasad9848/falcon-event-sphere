# Copy to .env and fill in real values
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/falcon_events
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173

# Optional: turns on AI re-ranking of recommendations with Claude.
# Without it, the app uses its built-in scoring engine.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
